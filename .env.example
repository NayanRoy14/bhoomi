# Copy to .env and adjust. .env is gitignored -- never commit real credentials.

# ---------------------------------------------------------------- backend
BHOOMI_LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API from a browser.
BHOOMI_CORS_ORIGINS=http://localhost:3000

# Override the STAC endpoint. Empty uses Element84 Earth Search (PLAN.md D9).
BHOOMI_STAC_ENDPOINT=

# Scene metadata cache (PLAN.md 6). Leave empty to run without a database --
# search still works, it just re-queries STAC every time. The compose file sets
# this for the backend container; this value is for running uvicorn directly.
BHOOMI_DATABASE_URL=

# Seconds to wait for a database connection before serving the request without
# the cache. Left unbounded, an unreachable host takes ~130 s to fail, which
# would make a Postgres outage look like an outage of the whole API.
BHOOMI_DB_CONNECT_TIMEOUT=5

# Password for the compose postgres service. Only used by docker compose.
POSTGRES_PASSWORD=bhoomi

# ---------------------------------------------------------------- frontend
# Inlined into the bundle at build time by Next.js, so this must be the URL the
# browser will use -- not a compose service name.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --------------------------------------------------- not yet used (see PLAN)
# REDIS_URL=                    # job queue, January 2027
# R2_ACCESS_KEY_ID=             # output storage, PLAN.md O4
# R2_SECRET_ACCESS_KEY=
# BHOONIDHI_USER=               # PLAN.md 2.2 -- gated on NRSC access
