# Copy to .env and adjust. .env is gitignored -- never commit real credentials.

# ---------------------------------------------------------------- backend
BHOOMI_LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API from a browser.
BHOOMI_CORS_ORIGINS=http://localhost:3000

# Override the STAC endpoint. Empty uses Element84 Earth Search (PLAN.md D9).
BHOOMI_STAC_ENDPOINT=

# Scene metadata cache (PLAN.md 6). Leave empty to run without a database --
# search still works, it just re-queries STAC every time. The compose file sets
# this for the backend container; this value is for running uvicorn directly.
BHOOMI_DATABASE_URL=

# Seconds to wait for a database connection before serving the request without
# the cache. Left unbounded, an unreachable host takes ~130 s to fail, which
# would make a Postgres outage look like an outage of the whole API.
BHOOMI_DB_CONNECT_TIMEOUT=5

# Password for the compose postgres service. Only used by docker compose.
POSTGRES_PASSWORD=bhoomi

# ---------------------------------------------------------------- frontend
# Inlined into the bundle at build time by Next.js, so this must be the URL the
# browser will use -- not a compose service name.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Job queue (PLAN.md 4.2). Leave empty to run without one -- scene search still
# works; job submission returns 503 rather than accepting work it cannot run.
# Compose sets this for the backend and worker containers.
BHOOMI_REDIS_URL=

# Hard kill for a job, in seconds (PLAN.md 8). Status becomes `timed_out`.
BHOOMI_JOB_TIMEOUT=600

# Job submissions per IP per hour. Much tighter than the 120/hour search
# budget: each one is real compute, not a proxied query.
BHOOMI_JOB_LIMIT=20

# Job status polls per IP per hour. Much larger than the search budget: the UI
# polls at 2 s while a job runs (PLAN.md 7.4), and a status poll is a local
# read rather than a request forwarded to the catalogue.
BHOOMI_POLL_LIMIT=1200

# Where finished COGs are written (PLAN.md D5, O4). Local disk until the
# object-storage decision lands; the worker and the API must share it.
BHOOMI_OUTPUT_DIR=outputs/jobs

# Written into outputs.cog_uri, so it must be the URL a client can reach --
# not a compose service name.
BHOOMI_PUBLIC_BASE_URL=http://localhost:8000

# Refuse to publish a raster larger than this (PLAN.md 8), in megabytes.
BHOOMI_MAX_OUTPUT_MB=200

# Tile server (PLAN.md 11). Empty disables tiles entirely: the API returns
# `tiles: null` and the UI says there is no map preview, rather than offering a
# link that 404s.
BHOOMI_TITILER_URL=http://localhost:8001

# Where the tile server mounts the outputs volume. Only meaningful while
# outputs live on a filesystem; object storage (O4) replaces it with a URL.
BHOOMI_TILE_ROOT=

# ------------------------------------------- object storage (PLAN.md D14)
# Setting BHOOMI_S3_BUCKET switches outputs from local disk to object storage;
# leaving it empty keeps the local backend. R2 is the chosen provider, but this
# is the plain S3 API, so S3 and MinIO work with a different endpoint.
BHOOMI_S3_BUCKET=
BHOOMI_S3_ENDPOINT=             # R2: https://<account-id>.r2.cloudflarestorage.com
BHOOMI_S3_ACCESS_KEY_ID=
BHOOMI_S3_SECRET_ACCESS_KEY=
BHOOMI_S3_REGION=auto           # R2 ignores it; the SDK requires one

# A bucket's public r2.dev address or custom domain, if it has one. With it,
# cog_uri points straight at the object and the tile server needs no
# credentials. Without it the bucket stays private and the API streams
# downloads -- a presigned URL would expire inside a 30-day-lived row.
BHOOMI_S3_PUBLIC_BASE_URL=

# GDAL's /vsis3/ reads these rather than the boto3 pair above, and wants the
# endpoint as a bare host -- no scheme, or every tile request fails.
BHOOMI_S3_GDAL_ENDPOINT=        # e.g. <account-id>.r2.cloudflarestorage.com
BHOOMI_S3_GDAL_HTTPS=YES        # NO only for a plaintext local S3 server

# ------------------------------------------- production only (docs/deploy.md)
# Used by docker-compose.prod.yml, which derives the public API base URL, the
# tile URL, the CORS origin and the frontend's NEXT_PUBLIC_API_URL from it.
# Hostname only -- no scheme, no trailing slash. Next.js inlines the frontend's
# copy at build time, so changing this means rebuilding that image.
BHOOMI_DOMAIN=

# Overrides the PostGIS image. The prod overlay defaults to a multi-arch build
# because postgis/postgis is amd64-only and will not start on ARM hosts such as
# Oracle Ampere. Set this back to postgis/postgis:16-3.4 on an amd64 host.
BHOOMI_POSTGIS_IMAGE=

# How many X-Forwarded-For hops belong to proxies of ours. 0 (the default)
# ignores the header entirely. Behind exactly one reverse proxy set 1 -- see
# docs/deploy.md, and note that too high a value lets a client forge its own
# client address and reset its rate-limit budget.
BHOOMI_TRUSTED_PROXY_HOPS=0

# --------------------------------------------------- not yet used (see PLAN)
# BHOONIDHI_USER=               # PLAN.md 2.2 -- gated on NRSC access
