# Normalise line endings in the repository; check out native on Windows.
* text=auto

*.py   text diff=python
*.md   text
*.txt  text

# Must stay LF even when checked out on Windows: these are copied into a Linux
# image, and a CRLF shebang line becomes `/bin/sh^M: bad interpreter`.
*.sh   text eol=lf

*.png  binary
*.jpg  binary
*.tif  binary
*.npy  binary
*.npz  binary
